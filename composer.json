    "illuminate/pagination": "^9.18",
    "jasongrimes/paginator": "~1.0",
    "illuminate/redis": "^9.18",
    "psr/container": "^2.0.2",
    "webman/action-hook": "^1.0",
    "symfony/http-foundation": "^3.0",
    "tinywan/storage": "^0.3.3",
    "workerman/redis": "^2.0",
    "predis/predis": "^2.0",
    "phpmailer/phpmailer": "^6.6",
